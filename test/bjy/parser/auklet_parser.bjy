let string = list int
let eof=-1

let Token =
  | `TokMult of ()
  | `TokPlus of ()
  | `TokInt of string
  | `TokVar of string
  | `TokMinus of ()
  | `TokOpenParen of ()
  | `TokCloseParen of ()
  | `TokLet of ()
  | `TokIn of ()
  | `TokEqual of ()
  | `TokAfter of ()
  | `TokBefore of ()
  | `Invalid of ()

let Tree = | `EInt of int| `EVar of string| `EBinaryOp of  {e1:Tree; e2:Tree}
| `EOpPlus of {e1:Tree; e2:Tree} | `EOpMinus of {e1:Tree; e2:Tree} | `OpTimes of  {e1:Tree; e2:Tree} 
| `EUnaryOp of Tree| `EAfter of Tree | `EBefore of Tree | `ELet of {var: string; e1:Tree; e2:Tree}

let Result = fun t -> `Success of t | `Failure of int
let TokResult = Result {s:string; tok:Token}
let StringResult = Result {result:string; file:string}

let pure x = `Success x

let bind x f = 
    match x with 
    | `Failure _ -> x
    | `Success y -> f y
    end 

let compose f g chars = 
    match (f chars) with 
    | `Success x -> `Success x
    | `Failure _ -> (g chars)
    end

let take_char (x:string): int =
    match x with
    | [] -> -1
    | a::b -> a
    end

let drop_char (x:string): string =
    match x with
    | a::b -> b
    end

(*this is partially messy since i don't know of a way to calculate length of a list*)
let rec str_compare (short:string) (long:string): {eq: bool; s: string} =
    let hd = take_char short in
    let a = take_char long in
    if hd==-1 then if a==[] then {eq=true; s=[]} else {eq=true; s=(drop_char long)}
    else if hd==a then str_compare (drop_char short) (drop_char long) else {eq=false; s=[]}
(*bind function is for top level passing lexed stuff into parse*)

(*how to handle variables: back into ascii?
also how to handle syntax errors/invalid variables ugh*)

let rec get_input (x:int): string =
    let var = input in
    if var == eof then [] 
    else var::(get_input 1)

let tokenize_mult (s:string): TokResult =
    let hd= take_char s in
    if hd==42 then `Success {s=(drop_char s); tok= `TokMult ()} else `Failure 0

let tokenize_plus (s:string): TokResult =
    let hd= take_char s in
    if hd==43 then `Success {s=drop_char s; tok=`TokPlus ()} else `Failure 0

let tokenize_minus (s:string): TokResult =
    let hd= take_char s in
    if hd==45 then `Success {s=drop_char s; tok=`TokMinus ()} else `Failure 0

let tokenize_openparen (s:string): TokResult =
    let hd= take_char s in
    if hd==40 then `Success {s=drop_char s; tok=`TokOpenParen ()} else `Failure 0

let tokenize_closeparen (s:string): TokResult =
    let hd= take_char s in
    if hd==41 then `Success {s=drop_char s; tok=`TokCloseParen ()} else `Failure 0

let tokenize_equal (s:string): TokResult =
    let hd= take_char s in
    if hd==61 then `Success {s=drop_char s; tok=`TokEqual ()} else `Failure 0

let tokenize_in (s:string): TokResult =
    let comp = str_compare [105;110] s in
    if comp.eq == true then `Success {s=comp.s; tok=`TokIn ()} else `Failure 0

let tokenize_let (s:string): TokResult =
    let comp = str_compare [108;101;116] s in
    if comp.eq == true then `Success {s=comp.s; tok=`TokLet ()} else `Failure 0

let tokenize_after (s:string): TokResult =
    let comp = str_compare [97;102;116;101;114] s in
    if comp.eq == true then `Success {s=comp.s; tok=`TokAfter ()} else `Failure 0

let tokenize_before (s:string): TokResult =
    let comp = str_compare [98;101;102;111;114;101] s in
    if comp.eq == true then `Success {s=comp.s; tok=`TokBefore ()} else `Failure 0

(*add f as a predicate to be cleaner*)
let tokenize_int (file:string): TokResult = 
    let rec match_int (current:{result:string; file:string}): StringResult =
    match file with
    | hd::tl -> 
        if hd==32 then `Success {file=tl; result=current.result} else
        if (48<=hd && hd<=57)
        then match_int ({result=current.result::hd;file=tl}) else `Failure 1
    end
    in 
    match (match_int ({result=[]; file=file})) with 
    | `Success x -> `Success {s=x.file; tok=`TokInt(x.result)}
    | `Failure y -> `Failure y
    end

let tokenize_var (file: string): TokResult = 
    let rec match_var (current:{result:string; file:string}): StringResult =
    match file with
    | hd::tl -> 
        if hd==32 then `Success {file=tl; result=current.result} else 
        if ((65<=hd && hd<=90) || (97<=hd && hd<=122)) 
        then match_var ({result=current.result::hd;file=tl}) else `Failure 1
    end
    in
    match (match_var ({result=[]; file=file})) with 
    | `Success x -> `Success {s=x.file; tok=`TokVar(x.result)}
    | `Failure y -> `Failure y
    end

let rec lex_token (file: string): list Token =
    compose tokenize_mult (compose tokenize_plus (compose tokenize_minus (compose tokenize_openparen 
    (compose tokenize_closeparen (compose tokenize_equal (compose tokenize_in (compose tokenize_let 
    (compose tokenize_after (compose tokenize_before (compose tokenize_int (compose tokenize_var (fun x-> `Failure 1)))))))))))) file
(*hard coding this in?*)

